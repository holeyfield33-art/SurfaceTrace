{
  "name": "surfacetrace",
  "version": "0.1.0",
  "private": true,
  "description": "Human-in-the-loop attack-surface and threat-mapping cockpit",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "prebuild": "npm run check:node",
    "build": "npm run build --workspaces --if-present",
    "predev": "npm run check:node && npm run build --workspace=@surfacetrace/core",
    "dev": "npm run dev --workspace=@surfacetrace/server",
    "predev:web": "npm run check:node",
    "dev:web": "npm run dev --workspace=@surfacetrace/web",
    "predev:all": "npm run check:node && npm run build --workspace=@surfacetrace/core",
    "dev:all": "node scripts/dev-all.mjs",
    "lab": "node examples/controlled-replay-lab/lab.mjs",
    "lab:test": "node --test examples/controlled-replay-lab/test/lab.test.mjs",
    "pree2e": "npm run build",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "start:e2e:api": "node packages/server/dist/index.js",
    "start:e2e:web": "npm run preview --workspace=@surfacetrace/web -- --port 5173",
    "start:e2e:lab": "node examples/controlled-replay-lab/lab.mjs",
    "team:pentest": "node scripts/security-team.mjs start pentest",
    "team:redteam": "node scripts/security-team.mjs start redteam",
    "team:gate": "node scripts/security-team.mjs gate",
    "team:test": "node --test scripts/test/*.test.mjs",
    "pretest": "npm run check:node",
    "test": "npm run test --workspaces --if-present",
    "pretypecheck": "npm run check:node && npm run build --workspace=@surfacetrace/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "node scripts/lint-workspaces.mjs && eslint playwright.config.ts e2e --max-warnings=0"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.9.0",
    "eslint": "^10.9.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
