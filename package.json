{
  "name": "surfacetrace",
  "version": "0.1.0",
  "private": true,
  "description": "Human-in-the-loop attack-surface and threat-mapping cockpit",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=@surfacetrace/server",
    "dev:web": "npm run dev --workspace=@surfacetrace/web -- --host 0.0.0.0",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
