{
  "name": "SurfaceTrace",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "surfacetrace",
  "workspaceFolder": "/workspace/SurfaceTrace",
  "overrideCommand": false,
  "forwardPorts": [5173, 8787, 4040],
  "portsAttributes": {
    "5173": {
      "label": "SurfaceTrace UI",
      "onAutoForward": "openBrowser"
    },
    "8787": {
      "label": "SurfaceTrace API",
      "onAutoForward": "notify"
    },
    "4040": {
      "label": "Controlled Replay Lab",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "postCreateCommand": "npm run check:node"
}
